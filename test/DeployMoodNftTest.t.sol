pragma solidity ^0.8.20;
import {Test} from "forge-std/Test.sol";
import {DeployMoodNft} from "../script/DeployMoodNft.s.sol";

contract DeployMoodNftTest is Test {
    DeployMoodNft public deployer;

    function setUp() public {
        deployer = new DeployMoodNft();
    }

    // Base64 encodes exact bytes, so the SVG must match the file byte for byte
    // (newlines, indentation, spacing). Reading the file avoids copy/paste drift.
    function testConvertSvgToURI() public view {
        string memory expectedURI =
            "data:image/svg+xml;base64,";
        string memory svg = vm.readFile("./img/happy.svg");
        string memory actualURI = deployer.svgToImageURI(svg);
        assertEq(actualURI, expectedURI);
    }
}
